#!/bin/sh

# Not elevated yet: finish the install cleanly and tell the administrator
# what to run. The package stays installed but stopped until approved.
if [ ! -x "$BROKER" ]; then
    {
        echo "$SYNOPKG_PKGNAME is installed but not yet allowed to manage its Docker container."
        echo "Run the following command once as administrator to review and enable it:"
        echo "    $ELEVATE_CMD"
    } >"${SYNOPKG_TEMP_LOGFILE:-/dev/stderr}"
    exit 0
fi

# Elevated: (re)create the container from the approved profile snapshot.
sudo -n "$BROKER" install
rc=$?

# Broker refused: the shipped profile changed and needs a new approval.
if [ $rc -eq 75 ]; then
    {
        echo "The container profile shipped with this version differs from the approved one."
        echo "Review and re-approve it with:"
        echo "    $ELEVATE_CMD"
    } >"${SYNOPKG_TEMP_LOGFILE:-/dev/stderr}"
    exit 0
fi

exit $rc
