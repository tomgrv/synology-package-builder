#!/bin/sh

# Docker preset: runs as the package user for every lifecycle context.
# Renders the container profile(s) from the wizard values while they are
# available, then hands over to the context script ($PRESETS_CONTEXT.docker)
# which drives the root broker installed by scripts/elevate.

# Ensure the script is run with the correct environment
if [ -z "$SYNOPKG_PKGDEST" ] || [ -z "$SYNOPKG_CONF" ] || [ -z "$SYNOPKG_PKGNAME" ]; then
    echo "Package environment variables are not set."
    echo "This script must not be run directly, but as part of a Synology package."
    exit 1
fi

# Ensure the context is set
if [ ! -f "$PRESETS_FILE" ]; then
    echo "Presets file not found: $PRESETS_FILE"
    exit 1
fi

# Root broker installed by scripts/elevate (see doc/elevated.md)
export BROKER="/usr/local/lib/synopkg-broker/$SYNOPKG_PKGNAME/broker"
export ELEVATE_CMD="sudo /var/packages/$SYNOPKG_PKGNAME/scripts/elevate"

# Render every profile with the wizard values while they are available; the
# rendered copies may contain secrets, keep them private to the package user
case "$PRESETS_NAME" in
postinst | postupgrade)
    jq -r '.docker[].profile' "$PRESETS_FILE" | while read -r profile; do

        template="$SYNOPKG_PKGDEST/$profile"
        test -f "$template" || template="$SYNOPKG_CONF/$profile"
        rendered="$SYNOPKG_PKGHOME/$(basename "$profile")"

        echo "Rendering container profile $profile to $rendered"
        "$(dirname $0)"/_substitute "$template" "$rendered" "docker" || exit $?
        chmod 600 "$rendered"
    done || exit $?
    ;;
esac

# Hand over to the context script, which talks to the root broker
if [ -x "$PRESETS_CONTEXT.docker" ]; then
    echo "Running preset $PRESETS_CONTEXT.docker with arguments: $@"
    exec "$PRESETS_CONTEXT.docker" "$@"
fi
