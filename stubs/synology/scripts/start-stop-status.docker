#!/bin/sh

case "$1" in
start | stop)
    if [ ! -x "$BROKER" ]; then
        {
            echo "$SYNOPKG_PKGNAME is not elevated yet."
            echo "Run the following command once as administrator to review and enable it:"
            echo "    $ELEVATE_CMD"
        } >"${SYNOPKG_TEMP_LOGFILE:-/dev/stderr}"
        exit 150
    fi
    exec sudo -n "$BROKER" "$1"
    ;;

status)
    [ -x "$BROKER" ] || exit 1
    exec sudo -n "$BROKER" status
    ;;

*)
    exit 1
    ;;
esac
